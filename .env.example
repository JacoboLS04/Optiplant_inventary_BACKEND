# ===== Postgres =====
# Base de datos de la aplicación.
DB_NAME=optiplant
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ===== Backend =====
# Origen admitido por CORS (separar varios con comas).
# En el despliegue por defecto el frontend se sirve en http://localhost.
CORS_ALLOWED_ORIGINS=http://localhost
# Secreto JWT (base64, mínimo 32 bytes tras decodificar). ¡Cámbialo en producción!
JWT_SECRET=inserta-aqui-un-secreto-base64-de-mas-de-32-bytes
# Expiración del token en milisegundos (86400000 = 24 h).
JWT_EXPIRATION=86400000

# ===== Frontend =====
# Ruta base de la API embebida en el build del frontend.
# Con "/api" las peticiones pasan por nginx y se redirigen al backend.
VITE_API_URL=/api
